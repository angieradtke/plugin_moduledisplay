<?xml version="1.0" encoding="utf-8"?>
<form>

    <fields name="params">

        <fieldset name="moduledisplay" label="PLG_SYSTEM_MODULEDISPLAY_FIELDSET">

            <field
                name="moduledisplay_enabled"
                type="radio"
                default="0"
                label="PLG_SYSTEM_MODULEDISPLAY_ENABLED"
                description="PLG_SYSTEM_MODULEDISPLAY_ENABLED_DESC"
                class="btn-group btn-group-yesno"
            >

                <option value="0">JNO</option>
                <option value="1">JYES</option>

            </field>

            <field
                name="moduledisplay_rules"
                type="moduledisplayselect"
                addfieldprefix="Joomla\Plugin\System\ModuleDisplay\Field"
                multiple="true"
                size="14"
                label="PLG_SYSTEM_MODULEDISPLAY_RULES"
                description="PLG_SYSTEM_MODULEDISPLAY_RULES_DESC"
                showon="moduledisplay_enabled:1"
            />

        </fieldset>

    </fields>

</form>
